# BEGIN YuMapAI web uygulaması (15.11.2026, yumapai-web deposundan dağıtılır — elle değiştirmeyin)
# Ana adres uygulamayı açar; gizlilik/, destek/, isletmeler/, ozellikler/, tanitim/ gibi klasörler olduğu gibi sunulur.
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteRule (^|/)\.(?!well-known) - [F,L]
# Önceden sıkıştırılmış motor (.wasm) ve simge fontu: tarayıcı kabul ediyorsa .br/.gz eşi sunulur (LiteSpeed bunları kendisi sıkıştırmıyor)
RewriteCond %{HTTP:Accept-Encoding} br
RewriteCond %{REQUEST_FILENAME}.br -f
RewriteRule ^(.+\.(?:wasm|otf))$ $1.br [L,E=no-gzip:1]
RewriteCond %{HTTP:Accept-Encoding} gzip
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^(.+\.(?:wasm|otf))$ $1.gz [L,E=no-gzip:1]
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>
<IfModule mod_mime.c>
AddType application/wasm .wasm
AddType text/javascript .js .mjs
AddType font/ttf .ttf
AddType font/otf .otf
AddType font/woff2 .woff2
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json font/ttf image/svg+xml
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' blob: https: wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
<FilesMatch "\.(html|css|js|json)$">
Header set Cache-Control "no-cache"
</FilesMatch>
# Flutter motoru ve emoji fontları sürümler arasında nadiren değişir: telefonda 7 gün saklanır.
<If "%{REQUEST_URI} =~ m#^/(canvaskit|ff-fonts)/#">
Header set Cache-Control "public, max-age=604800"
</If>
# Uygulamanın simge ve yazı tipleri sürümle değişebilir: her açılışta sunucuya sorulur (değişmediyse indirilmez).
<ElseIf "%{REQUEST_URI} =~ m#^/assets/(fonts|packages)/#">
Header set Cache-Control "no-cache"
</ElseIf>
# Görseller ve ikonlar: 1 gün
<FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
Header set Cache-Control "public, max-age=86400"
</FilesMatch>
</IfModule>
<IfModule mod_mime.c>
RemoveType .br .gz
</IfModule>
<FilesMatch "\.wasm\.br$">
ForceType application/wasm
Header set Content-Encoding br
Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "\.wasm\.gz$">
ForceType application/wasm
Header set Content-Encoding gzip
Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "\.otf\.br$">
ForceType font/otf
Header set Content-Encoding br
Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "\.otf\.gz$">
ForceType font/otf
Header set Content-Encoding gzip
Header append Vary Accept-Encoding
</FilesMatch>
# END YuMapAI
